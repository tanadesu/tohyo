{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", "firestore.rules", "README.md", ".git", ".git/**", ".firebase", ".firebase/**", "firebase-debug.log", "**/.*", "**/node_modules/**"],
    "headers": [{ "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  }
}
